<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks microphone access without this entitlement. Screen Recording has no entitlement; it is a TCC grant. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
